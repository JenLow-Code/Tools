{
  // JenLow Tools — Worker + static assets.
  // The Worker (worker/index.js) serves /api/* from D1 and falls through to
  // the built SPA in ./dist for everything else.
  "name": "tools",
  "compatibility_date": "2025-11-05",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // ---- Cloudflare D1 ----
  // Wired to the separate Tools database (Network's DB is not shared — see SETUP.md).
  // To apply schema + seed data: wrangler d1 migrations apply jenlow-tools --remote
  //    (this runs migrations/0001_init.sql then migrations/0002_seed.sql)
  "d1_databases": [
    { "binding": "DB", "database_name": "jenlow-tools", "database_id": "4027373e-8055-41cc-8cd0-3f107e16b299" }
  ]
}
